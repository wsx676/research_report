+# -*- coding: utf-8 -*-
+"""Pluggable stage-exit quality gate for swarm pipelines (QualityGate).
+
+A generic review gate that decides which candidate may leave a pipeline
+stage.  It is intentionally domain-agnostic: the rubric, pass threshold,
+hard checks and circuit-breaker policy are all configuration, so the same
+component serves research-hypothesis screening, code-review gating,
+content moderation, etc.
+
+Features
+--------
+- Configurable rubric: named dimensions with weights (weighted scoring).
+- Configurable threshold: a candidate passes when its weighted score
+  reaches ``GateConfig.threshold`` and all hard checks pass.
+- Review records on disk: every ``review()`` call appends one JSON line
+  to ``records_dir/quality_gate_reviews.jsonl`` for auditing.
+- Built-in circuit breaker: after ``max_iterations`` consecutive rounds
+  without a passing candidate, the highest-scoring candidate is force
+  accepted (marked ``forced=True``) so long-running pipelines cannot
+  deadlock in an endless refine loop.
+
+Example (non-research usage — code review gate)::
+
+    config = GateConfig(
+        dimensions=[RubricDimension("coverage", 0.5),
+                    RubricDimension("style", 0.5)],
+        threshold=0.7,
+    )
+    gate = QualityGate(config)
+    decision = gate.review([Candidate("pr-42", scores={"coverage": 0.9,
+                                                        "style": 0.8})])
+    assert decision.passed and decision.candidate_id == "pr-42"
+"""
+from __future__ import annotations
+
+import json
+import threading
+import time
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any, Callable, Dict, List, Optional
+
+RECORDS_FILENAME = "quality_gate_reviews.jsonl"
+
+#: Signature of a hard check: receives a candidate, returns True when OK.
+HardCheck = Callable[["Candidate"], bool]
+
+
+@dataclass
+class RubricDimension:
+    """One scoring dimension of the rubric.
+
+    Attributes:
+        name: Dimension identifier (e.g. ``"novelty"``).
+        weight: Non-negative weight; weights are normalised at review time,
+            so they do not need to sum to 1.
+        description: Human-readable description, persisted into records.
+    """
+
+    name: str
+    weight: float = 1.0
+    description: str = ""
+
+
+@dataclass
+class GateConfig:
+    """Configuration for :class:`QualityGate`.
+
+    Attributes:
+        dimensions: Rubric dimensions (at least one).
+        threshold: Weighted-score threshold in [0, 1] required to pass.
+        max_iterations: Circuit-breaker budget — after this many
+            consecutive rounds without a passing candidate, the best
+            candidate is force accepted. ``0`` disables the breaker.
+        hard_checks: Named callables that must all pass regardless of
+            score (e.g. budget compliance, policy compliance).
+        gate_name: Label used in records and log messages.
+    """
+
+    dimensions: List[RubricDimension]
+    threshold: float = 0.6
+    max_iterations: int = 3
+    hard_checks: Dict[str, HardCheck] = field(default_factory=dict)
+    gate_name: str = "quality_gate"
+
+    def __post_init__(self) -> None:
+        if not self.dimensions:
+            raise ValueError("GateConfig requires at least one dimension")
+        if any(d.weight < 0 for d in self.dimensions):
+            raise ValueError("dimension weights must be non-negative")
+        if not 0.0 <= self.threshold <= 1.0:
+            raise ValueError("threshold must be within [0, 1]")
+
+    @classmethod
+    def ideation_default(cls, threshold: float = 0.6,
+                         max_iterations: int = 3) -> "GateConfig":
+        """Rubric used by research-ideation gates (equal weights)."""
+        return cls(
+            dimensions=[
+                RubricDimension("novelty", 0.25, "differs from prior work"),
+                RubricDimension("verifiability", 0.25, "has a testable prediction"),
+                RubricDimension("compute_feasibility", 0.25, "fits the compute budget"),
+                RubricDimension("boundary_clarity", 0.25, "scope is well defined"),
+            ],
+            threshold=threshold,
+            max_iterations=max_iterations,
+            gate_name="ideation_gate",
+        )
+
+
+@dataclass
+class Candidate:
+    """One candidate submitted to the gate.
+
+    Attributes:
+        id: Unique candidate identifier.
+        scores: Dimension name -> score in [0, 1]. Missing dimensions
+            count as 0.
+        payload: Arbitrary caller metadata (echoed into records only when
+            ``record_payload=True`` is passed to :meth:`QualityGate.review`).
+    """
+
+    id: str
+    scores: Dict[str, float] = field(default_factory=dict)
+    payload: Dict[str, Any] = field(default_factory=dict)
+
+
+@dataclass
+class GateDecision:
+    """Outcome of one :meth:`QualityGate.review` round.
+
+    Attributes:
+        passed: Whether some candidate was accepted this round.
+        candidate_id: Accepted candidate id (``None`` when not passed).
+        forced: True when acceptance came from the circuit breaker.
+        reason: Human-readable explanation.
+        weighted: Weighted score per candidate id, for auditing.
+        hard_check_failures: Candidate id -> names of failed hard checks.
+        iteration: Iteration counter echoed from the caller.
+    """
+
+    passed: bool
+    candidate_id: Optional[str]
+    forced: bool
+    reason: str
+    weighted: Dict[str, float] = field(default_factory=dict)
+    hard_check_failures: Dict[str, List[str]] = field(default_factory=dict)
+    iteration: int = 1
+
+
+class QualityGate:
+    """Stage-exit review gate with on-disk audit trail and circuit breaker.
+
+    Args:
+        config: Gate configuration (rubric, threshold, breaker policy).
+        records_dir: Optional directory receiving one JSON line per
+            review round. ``None`` disables persistence.
+    """
+
+    def __init__(self, config: GateConfig,
+                 records_dir: Optional[Path | str] = None) -> None:
+        self.config = config
+        self.records_dir = Path(records_dir) if records_dir else None
+        if self.records_dir is not None:
+            self.records_dir.mkdir(parents=True, exist_ok=True)
+        self._lock = threading.Lock()
+        self._consecutive_failures = 0
+
+    # ------------------------------------------------------------ scoring
+    def weighted_score(self, candidate: Candidate) -> float:
+        """Weighted rubric score in [0, 1]; missing dimensions count as 0."""
+        total_weight = sum(d.weight for d in self.config.dimensions)
+        if total_weight <= 0:
+            return 0.0
+        acc = 0.0
+        for dim in self.config.dimensions:
+            value = float(candidate.scores.get(dim.name, 0.0))
+            acc += dim.weight * max(0.0, min(1.0, value))
+        return acc / total_weight
+
+    def _failed_hard_checks(self, candidate: Candidate) -> List[str]:
+        return [name for name, fn in self.config.hard_checks.items()
+                if not fn(candidate)]
+
+    # ------------------------------------------------------------- review
+    def review(self, candidates: List[Candidate], iteration: int = 1,
+               record_payload: bool = False) -> GateDecision:
+        """Review one batch of candidates and return the gate decision.
+
+        The ``iteration`` counter should be advanced by the caller on each
+        refine round; the circuit breaker fires after
+        ``config.max_iterations`` consecutive rounds without acceptance.
+        """
+        if not candidates:
+            decision = GateDecision(False, None, False, "no candidates submitted",
+                                    iteration=iteration)
+            self._persist(decision, candidates, record_payload)
+            return decision
+
+        weighted = {c.id: self.weighted_score(c) for c in candidates}
+        hard_failures = {c.id: self._failed_hard_checks(c) for c in candidates}
+        eligible = [c for c in candidates
+                    if not hard_failures[c.id]
+                    and weighted[c.id] >= self.config.threshold]
+
+        forced = False
+        if eligible:
+            winner = max(eligible, key=lambda c: weighted[c.id])
+            self._consecutive_failures = 0
+            reason = (f"weighted score {weighted[winner.id]:.3f} >= "
+                      f"threshold {self.config.threshold}")
+        else:
+            self._consecutive_failures += 1
+            breaker_armed = (self.config.max_iterations > 0
+                             and self._consecutive_failures >= self.config.max_iterations)
+            if breaker_armed:
+                # Circuit breaker: force accept the best draft to avoid an
+                # endless refine loop. Hard-check failures still block —
+                # pick the highest scorer among hard-check-clean candidates,
+                # falling back to the global best when none qualify.
+                clean = [c for c in candidates if not hard_failures[c.id]]
+                pool = clean or candidates
+                winner = max(pool, key=lambda c: weighted[c.id])
+                forced = True
+                reason = (f"circuit breaker after {self._consecutive_failures} "
+                          f"rounds without acceptance; force accepted best draft")
+                self._consecutive_failures = 0
+            else:
+                decision = GateDecision(
+                    False, None, False,
+                    f"no candidate reached threshold {self.config.threshold} "
+                    f"(round {self._consecutive_failures}/"
+                    f"{self.config.max_iterations or '∞'})",
+                    weighted=weighted, hard_check_failures=hard_failures,
+                    iteration=iteration)
+                self._persist(decision, candidates, record_payload)
+                return decision
+
+        decision = GateDecision(True, winner.id, forced, reason,
+                                weighted=weighted,
+                                hard_check_failures=hard_failures,
+                                iteration=iteration)
+        self._persist(decision, candidates, record_payload)
+        return decision
+
+    def reset_breaker(self) -> None:
+        """Reset the consecutive-failure counter (e.g. on new topic)."""
+        self._consecutive_failures = 0
+
+    # ------------------------------------------------------------- record
+    def _persist(self, decision: GateDecision, candidates: List[Candidate],
+                 record_payload: bool) -> None:
+        if self.records_dir is None:
+            return
+        record = {
+            "ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
+            "gate": self.config.gate_name,
+            "iteration": decision.iteration,
+            "threshold": self.config.threshold,
+            "rubric": {d.name: d.weight for d in self.config.dimensions},
+            "candidates": [
+                {
+                    "id": c.id,
+                    "scores": c.scores,
+                    "weighted": decision.weighted.get(c.id),
+                    "hard_check_failures": decision.hard_check_failures.get(c.id, []),
+                    **({"payload": c.payload} if record_payload else {}),
+                }
+                for c in candidates
+            ],
+            "decision": {
+                "passed": decision.passed,
+                "candidate_id": decision.candidate_id,
+                "forced": decision.forced,
+                "reason": decision.reason,
+            },
+        }
+        line = json.dumps(record, ensure_ascii=False)
+        with self._lock:
+            with open(self.records_dir / RECORDS_FILENAME, "a",
+                      encoding="utf-8") as f:
+                f.write(line + "\n")
