+# -*- coding: utf-8 -*-
+"""Unit tests for :mod:`jiuwenswarm.common.quality_gate` (PR1: QualityGate).
+
+Covers: weighted scoring, threshold gate, hard checks, the circuit-breaker
+path (forced acceptance), on-disk review records and a non-research rubric
+to prove the component is domain-agnostic.
+"""
+from __future__ import annotations
+
+import json
+
+import pytest
+
+from jiuwenswarm.common.quality_gate import (
+    RECORDS_FILENAME,
+    Candidate,
+    GateConfig,
+    QualityGate,
+    RubricDimension,
+)
+
+
+@pytest.fixture()
+def ideation_gate(tmp_path):
+    """Ideation rubric gate (4 equal dimensions) with records enabled."""
+    config = GateConfig.ideation_default(threshold=0.6, max_iterations=3)
+    return QualityGate(config, records_dir=tmp_path)
+
+
+# ------------------------------------------------------------- validation
+class TestGateConfig:
+    def test_rejects_empty_dimensions(self):
+        with pytest.raises(ValueError):
+            GateConfig(dimensions=[])
+
+    def test_rejects_negative_weight(self):
+        with pytest.raises(ValueError):
+            GateConfig(dimensions=[RubricDimension("a", -0.1)])
+
+    def test_rejects_threshold_out_of_range(self):
+        with pytest.raises(ValueError):
+            GateConfig(dimensions=[RubricDimension("a")], threshold=1.2)
+
+    def test_ideation_default_has_four_dimensions(self):
+        config = GateConfig.ideation_default()
+        names = {d.name for d in config.dimensions}
+        assert names == {"novelty", "verifiability",
+                         "compute_feasibility", "boundary_clarity"}
+
+
+# --------------------------------------------------------------- scoring
+class TestScoring:
+    def test_weighted_score_normalises_weights(self):
+        config = GateConfig(
+            dimensions=[RubricDimension("a", 3.0), RubricDimension("b", 1.0)])
+        gate = QualityGate(config)
+        candidate = Candidate("c1", scores={"a": 1.0, "b": 0.0})
+        assert gate.weighted_score(candidate) == pytest.approx(0.75)
+
+    def test_missing_dimension_counts_as_zero(self):
+        gate = QualityGate(GateConfig(dimensions=[
+            RubricDimension("a"), RubricDimension("b")]))
+        assert gate.weighted_score(Candidate("c1", {"a": 0.8})) == \
+            pytest.approx(0.4)
+
+    def test_scores_clamped_to_unit_interval(self):
+        gate = QualityGate(GateConfig(dimensions=[RubricDimension("a")]))
+        assert gate.weighted_score(Candidate("c1", {"a": 1.7})) == \
+            pytest.approx(1.0)
+
+
+# ----------------------------------------------------------------- gate
+class TestReview:
+    def test_passes_candidate_above_threshold(self, ideation_gate):
+        good = Candidate("H1", {d.name: 0.8 for d in
+                                GateConfig.ideation_default().dimensions})
+        decision = ideation_gate.review([good])
+        assert decision.passed
+        assert decision.candidate_id == "H1"
+        assert not decision.forced
+
+    def test_rejects_all_below_threshold(self, ideation_gate):
+        weak = Candidate("H1", {d.name: 0.3 for d in
+                                GateConfig.ideation_default().dimensions})
+        decision = ideation_gate.review([weak])
+        assert not decision.passed
+        assert decision.candidate_id is None
+
+    def test_picks_highest_when_several_pass(self, ideation_gate):
+        low = Candidate("H1", {d.name: 0.65 for d in
+                               GateConfig.ideation_default().dimensions})
+        high = Candidate("H2", {d.name: 0.9 for d in
+                                GateConfig.ideation_default().dimensions})
+        decision = ideation_gate.review([low, high])
+        assert decision.candidate_id == "H2"
+
+    def test_hard_check_blocks_high_score(self):
+        config = GateConfig(
+            dimensions=[RubricDimension("score")],
+            threshold=0.5,
+            hard_checks={"within_budget":
+                         lambda c: c.payload.get("tokens", 0) <= 1000},
+        )
+        gate = QualityGate(config)
+        over = Candidate("c1", {"score": 0.9}, payload={"tokens": 5000})
+        decision = gate.review([over])
+        assert not decision.passed
+        assert decision.hard_check_failures["c1"] == ["within_budget"]
+
+    def test_empty_candidate_list_is_rejected(self, ideation_gate):
+        decision = ideation_gate.review([])
+        assert not decision.passed
+        assert "no candidates" in decision.reason
+
+
+# -------------------------------------------------------- circuit breaker
+class TestCircuitBreaker:
+    def test_forced_accept_after_max_iterations(self, ideation_gate):
+        """熔断路径：连续 3 轮无假设过门 → 强制放行最高分草案。"""
+        weak = Candidate("H1", {d.name: 0.3 for d in
+                                GateConfig.ideation_default().dimensions})
+        for iteration in (1, 2):
+            decision = ideation_gate.review([weak], iteration=iteration)
+            assert not decision.passed
+        decision = ideation_gate.review([weak], iteration=3)
+        assert decision.passed
+        assert decision.forced
+        assert decision.candidate_id == "H1"
+        assert "circuit breaker" in decision.reason
+
+    def test_breaker_counter_resets_after_pass(self, ideation_gate):
+        weak = Candidate("H1", {d.name: 0.3 for d in
+                                GateConfig.ideation_default().dimensions})
+        good = Candidate("H2", {d.name: 0.9 for d in
+                                GateConfig.ideation_default().dimensions})
+        ideation_gate.review([weak], iteration=1)
+        ideation_gate.review([weak], iteration=2)
+        assert ideation_gate.review([good], iteration=3).passed
+        # two more failures must NOT trip the breaker (counter was reset)
+        assert not ideation_gate.review([weak], iteration=4).passed
+        assert not ideation_gate.review([weak], iteration=5).passed
+        assert ideation_gate.review([weak], iteration=6).forced
+
+    def test_breaker_disabled_with_zero_max_iterations(self):
+        config = GateConfig(dimensions=[RubricDimension("a")],
+                            threshold=0.9, max_iterations=0)
+        gate = QualityGate(config)
+        weak = Candidate("c1", {"a": 0.5})
+        for _ in range(5):
+            decision = gate.review([weak])
+        assert not decision.passed and not decision.forced
+
+
+# --------------------------------------------------------------- records
+class TestRecords:
+    def test_review_record_appended_as_jsonl(self, ideation_gate, tmp_path):
+        good = Candidate("H1", {d.name: 0.8 for d in
+                                GateConfig.ideation_default().dimensions})
+        ideation_gate.review([good], iteration=1)
+        ideation_gate.review([], iteration=2)
+        lines = (tmp_path / RECORDS_FILENAME).read_text(
+            encoding="utf-8").strip().splitlines()
+        assert len(lines) == 2
+        record = json.loads(lines[0])
+        assert record["gate"] == "ideation_gate"
+        assert record["decision"]["candidate_id"] == "H1"
+        assert record["candidates"][0]["weighted"] == pytest.approx(0.8)
+
+    def test_payload_only_persisted_when_opted_in(self, ideation_gate,
+                                                  tmp_path):
+        good = Candidate("H1", {d.name: 0.8 for d in
+                                GateConfig.ideation_default().dimensions},
+                         payload={"secret": "x"})
+        ideation_gate.review([good], iteration=1)
+        ideation_gate.review([good], iteration=2, record_payload=True)
+        lines = (tmp_path / RECORDS_FILENAME).read_text(
+            encoding="utf-8").strip().splitlines()
+        assert "payload" not in json.loads(lines[0])["candidates"][0]
+        assert json.loads(lines[1])["candidates"][0]["payload"]["secret"] == "x"
+
+    def test_no_records_without_records_dir(self):
+        gate = QualityGate(GateConfig(dimensions=[RubricDimension("a")]))
+        decision = gate.review([Candidate("c1", {"a": 0.9})],
+                               iteration=1)
+        assert decision.passed  # no IO error without records_dir
+
+
+# ------------------------------------------------- non-research usage
+def test_generic_code_review_gate():
+    """同一组件服务非科研场景（代码评审门），验证 PR 通用性要求。"""
+    config = GateConfig(
+        dimensions=[RubricDimension("coverage", 0.6),
+                    RubricDimension("style", 0.4)],
+        threshold=0.7,
+        gate_name="code_review_gate",
+    )
+    gate = QualityGate(config)
+    decision = gate.review([
+        Candidate("pr-42", {"coverage": 0.9, "style": 0.8}),
+        Candidate("pr-43", {"coverage": 0.5, "style": 0.9}),
+    ])
+    assert decision.passed
+    assert decision.candidate_id == "pr-42"
+    assert decision.weighted["pr-42"] == pytest.approx(0.86)
