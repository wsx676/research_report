--- /dev/null
+++ b/tests/unit_tests/common/test_academic_format.py
@@ -0,0 +1,52 @@
+# -*- coding: utf-8 -*-
+"""Unit tests for jiuwenswarm.common.academic_format (PR3)."""
+from jiuwenswarm.common.academic_format import (
+    AcademicFormatValidator, audit_abstract, audit_citations, audit_numbers)
+
+
+def test_audit_numbers_flags_unregistered():
+    registry = {"0.6600", "0.66"}
+    problems = audit_numbers("score 0.6600 vs 0.1234", registry)
+    assert problems == ["unregistered number 0.1234 (not in sanctioned value set)"]
+    assert audit_numbers("all fine 0.6600 and 0.66", registry) == []
+
+
+def test_audit_numbers_empty_registry_disabled():
+    assert audit_numbers("any 0.9999 here", set()) == []
+
+
+def test_audit_citations_subset_rule():
+    assert audit_citations("\\cite{a,b}", "@misc{a,\n") == \
+        ["citation b missing from references database"]
+    assert audit_citations("\\citep{a}\\citet{a}", "@misc{a,\n") == []
+    assert audit_citations("no cites", "") == []
+
+
+def test_audit_abstract_presence_and_limit():
+    assert audit_abstract("\\begin{abstract}ok\\end{abstract}") == []
+    assert audit_abstract("nothing") == ["abstract environment missing"]
+    long_abs = "\\begin{abstract}" + " ".join(["w"] * 251) + "\\end{abstract}"
+    assert "exceeds limit 250" in audit_abstract(long_abs)[0]
+    assert audit_abstract(long_abs, word_limit=300) == []
+
+
+def test_validator_registers_both_forms():
+    v = AcademicFormatValidator()
+    v.register_number(0.99)
+    v.register_number(True)  # bools rejected
+    v.register_number("x")   # non-numbers rejected
+    assert v.registry == {"0.9900", "0.99"}
+
+
+def test_validator_bulk_and_validate():
+    v = AcademicFormatValidator()
+    n = v.register_numbers([0.45, 0.6, 0.66])
+    assert n > 0
+    tex = ("\\begin{abstract}main scores 0.6600.\\end{abstract}\n"
+           "see \\cite{k1}. margin 0.0600")
+    v.register_number(0.66 - 0.60)  # derived margin registered explicitly
+    assert v.validate(tex, "@article{k1,\n") == []
+    bad = v.validate(tex.replace("0.6600", "0.7777"), "@article{k1,\n")
+    assert any("0.7777" in p for p in bad)
+    bad2 = v.validate(tex, "")
+    assert any("k1" in p for p in bad2)
