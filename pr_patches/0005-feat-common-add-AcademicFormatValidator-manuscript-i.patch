+# -*- coding: utf-8 -*-
+"""Integrity audits for automatically generated academic manuscripts.
+
+Generated-paper pipelines are exposed to well-known failure modes:
+fabricated numbers drifting in from earlier runs, citations that do
+not exist, and abstracts that violate venue limits.  This module
+provides three domain-agnostic, purely textual audits that a writing
+stage can run *before* submission:
+
+Features
+--------
+- Number-consistency audit: every decimal in the manuscript must be a
+  member of a caller-supplied registry of sanctioned values (typically
+  derived from persisted experiment results).  Catches mixing numbers
+  across runs or LLM-invented figures.
+- Citation audit: every ``\\cite`` key used in the manuscript must
+  exist in the generated BibTeX database (hallucinated-reference
+  guard).
+- Abstract audit: presence and word-limit compliance of the abstract
+  environment.
+
+The audits are engine-agnostic (plain regex over LaTeX source); the
+caller decides what counts as a sanctioned number and how violations
+are handled (block vs. report).
+
+Example (writing-stage gate)::
+
+    v = AcademicFormatValidator()
+    for score in experiment_scores:
+        v.register_number(score)
+    problems = v.validate(tex_text, bib_text)
+    if problems:
+        raise RuntimeError(f"manuscript integrity audits failed: {problems}")
+"""
+from __future__ import annotations
+
+import re
+from typing import Any, Iterable, List, Union
+
+#: Decimals with 2-4 fractional digits, not embedded in identifiers.
+#: Lookahead only rejects further digits (longer decimals); a trailing
+#: sentence period still lets the value match.
+FLOAT_RE = re.compile(r"(?<![\w.])\d+\.\d{2,4}(?!\d)")
+#: \cite / \citep / \citet key groups (comma-separated allowed).
+CITE_RE = re.compile(r"\\cite[pt]?\{([^}]+)\}")
+ABSTRACT_RE = re.compile(r"\\begin\{abstract\}(.*?)\\end\{abstract\}", re.S)
+
+DEFAULT_ABSTRACT_WORD_LIMIT = 250
+
+
+def audit_numbers(text: str, registry: Iterable[str]) -> List[str]:
+    """Flag decimals in ``text`` absent from the sanctioned ``registry``.
+
+    An empty registry disables the audit (e.g. dry runs without
+    experiment results).  Returns one message per offending value.
+    """
+    registry = set(registry)
+    if not registry:
+        return []
+    offenders = sorted(set(FLOAT_RE.findall(text)) - registry)
+    return [f"unregistered number {v} (not in sanctioned value set)"
+            for v in offenders]
+
+
+def audit_citations(text: str, bib_text: str) -> List[str]:
+    """Flag ``\\cite`` keys not defined in the BibTeX database."""
+    cited: List[str] = []
+    for group in CITE_RE.findall(text):
+        cited.extend(k.strip() for k in group.split(","))
+    bib_keys = set(re.findall(r"@\w+\{([^,\s]+),", bib_text))
+    return [f"citation {k} missing from references database"
+            for k in dict.fromkeys(cited) if k not in bib_keys]
+
+
+def audit_abstract(text: str,
+                   word_limit: int = DEFAULT_ABSTRACT_WORD_LIMIT) -> List[str]:
+    """Require an abstract environment within the word limit."""
+    m = ABSTRACT_RE.search(text)
+    if not m:
+        return ["abstract environment missing"]
+    words = re.findall(r"\w+", re.sub(r"\\[a-zA-Z]+", " ", m.group(1)))
+    if len(words) > word_limit:
+        return [f"abstract has {len(words)} words, exceeds limit {word_limit}"]
+    return []
+
+
+class AcademicFormatValidator:
+    """Registry-aware manuscript integrity validator.
+
+    Args:
+        abstract_word_limit: Upper bound for abstract word count.
+
+    Number registration stores both a canonical 4-decimal form and the
+    shortest round-trip form of each value, so manuscripts may quote a
+    sanctioned number in either representation.  Derived quantities
+    (e.g. a margin computed from two registered values) must be
+    registered explicitly by the caller.
+    """
+
+    def __init__(self,
+                 abstract_word_limit: int = DEFAULT_ABSTRACT_WORD_LIMIT):
+        self.abstract_word_limit = abstract_word_limit
+        self.registry: set = set()
+
+    def register_number(self, value: Union[int, float]) -> None:
+        """Add a sanctioned numeric value (bools rejected)."""
+        if isinstance(value, bool) or not isinstance(value, (int, float)):
+            return
+        fv = float(value)
+        self.registry.add(f"{fv:.4f}")
+        self.registry.add(f"{fv:g}")
+
+    def register_numbers(self, values: Iterable[Any]) -> int:
+        """Bulk registration; returns how many values were accepted."""
+        before = len(self.registry)
+        for v in values:
+            self.register_number(v)
+        return len(self.registry) - before
+
+    def validate(self, tex_text: str, bib_text: str = "") -> List[str]:
+        """Run all audits; empty list means the manuscript passed."""
+        return (audit_citations(tex_text, bib_text) +
+                audit_numbers(tex_text, self.registry) +
+                audit_abstract(tex_text, self.abstract_word_limit))
